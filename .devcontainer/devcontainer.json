{
  "name": "Trino Development",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "JAVA_HOME": "/opt/java/temurin-25"
  }
}
